# Скопируй в .env и заполни. Файл .env в git не попадает.
# Без TURSO_DATABASE_URL сервер работает с локальным файлом data/noventis.db.
TURSO_DATABASE_URL=libsql://noventis-<логин>.turso.io
TURSO_AUTH_TOKEN=
# Длинный случайный секрет, тот же — в Cloudflare Pages. На своём компьютере оставь пустым.
PROXY_KEY=
NODE_ENV=production
# Адрес сайта — для ссылок в сообщениях бота
SITE_URL=https://noventis.pages.dev
# Telegram-бот (необязательно): токен и имя бота из @BotFather, секрет вебхука — любая длинная строка
TG_BOT_TOKEN=
TG_BOT_NAME=
TG_WEBHOOK_SECRET=
# Ключ для ежедневной рассылки напоминаний (тот же — в планировщике)
CRON_KEY=
